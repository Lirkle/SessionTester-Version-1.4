OPENAI_API_KEY=sk-your-key-here
# Comma-separated usernames allowed to change admin-only settings.
# ADMIN_USERNAMES=your_login
# Railway Postgres usually provides this automatically when the database is linked.
# DATABASE_URL=postgresql://user:password@host:port/database
# Also supported on Railway:
# DATABASE_PRIVATE_URL=postgresql://user:password@host:port/database
# DATABASE_PUBLIC_URL=postgresql://user:password@host:port/database
# Optional: override the default model used by the coach proxy.
# OPENAI_MODEL=gpt-5.5
# Optional: change local server port.
# PORT=8765
